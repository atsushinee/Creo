# Creo backend configuration (copy to .env and fill in real values)
# All variables use the CREO_ prefix unless they are provider-native keys.

# --- LLM ---
# The agent supports any provider known to langchain's init_chat_model.
# Examples: openai | anthropic | google_genai | deepseek | groq | xai ...
CREO_MODEL_PROVIDER=openai
CREO_MODEL_NAME=gpt-4o-mini

# Optional overrides. When empty, the provider integration falls back to its
# native env var (e.g. OPENAI_API_KEY) and its official endpoint.

# CREO_MODEL_API_KEY=sk-...
# CREO_MODEL_BASE_URL=

# --- OpenAI-compatible endpoints: just set provider=openai and point BASE_URL
#     at the service (DeepSeek, Qwen/DashScope, Moonshot, GLM, Ollama, vLLM...).
#     Examples:
#
# DeepSeek:
#   CREO_MODEL_PROVIDER=openai
#   CREO_MODEL_NAME=deepseek-chat
#   CREO_MODEL_BASE_URL=https://api.deepseek.com/v1
#   CREO_MODEL_API_KEY=sk-...
#
# Ollama (local):
#   CREO_MODEL_PROVIDER=openai
#   CREO_MODEL_NAME=qwen2.5:7b
#   CREO_MODEL_BASE_URL=http://localhost:11434/v1
#   CREO_MODEL_API_KEY=ollama
#
# Anthropic (official endpoint, key read from the provider-native variable):
#   CREO_MODEL_PROVIDER=anthropic
#   CREO_MODEL_NAME=claude-sonnet-4-5
#   ANTHROPIC_API_KEY=sk-ant-...

# Provider-native keys are read by the LangChain integration itself when
# CREO_MODEL_API_KEY is not set. Set the one matching your provider:
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- Agent ---
CREO_AGENT_INSTRUCTIONS=You are Creo, a precise and helpful AI agent working inside the Creo workspace.

# --- Server ---
CREO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CREO_LOG_LEVEL=INFO
