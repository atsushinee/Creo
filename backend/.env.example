# Creo backend configuration (copy to .env and fill in real values)
# All variables use the CREO_ prefix unless they are provider-native keys.

# --- LLM ---
# The agent supports any provider known to langchain's init_chat_model.
# Examples: openai | anthropic | google_genai | deepseek | groq | xai ...
CREO_MODEL_PROVIDER=openai
CREO_MODEL_NAME=gpt-4o-mini

# Optional overrides. When empty, the provider integration falls back to its
# native env var (e.g. OPENAI_API_KEY) and its official endpoint.

# CREO_MODEL_API_KEY=sk-...
# CREO_MODEL_BASE_URL=

# --- OpenAI-compatible endpoints: just set provider=openai and point BASE_URL
#     at the service (DeepSeek, Qwen/DashScope, Moonshot, GLM, Ollama, vLLM...).
#     Examples:
#
# DeepSeek:
#   CREO_MODEL_PROVIDER=openai
#   CREO_MODEL_NAME=deepseek-chat
#   CREO_MODEL_BASE_URL=https://api.deepseek.com/v1
#   CREO_MODEL_API_KEY=sk-...
#
# Ollama (local):
#   CREO_MODEL_PROVIDER=openai
#   CREO_MODEL_NAME=qwen2.5:7b
#   CREO_MODEL_BASE_URL=http://localhost:11434/v1
#   CREO_MODEL_API_KEY=ollama
#
# Anthropic (official endpoint, key read from the provider-native variable):
#   CREO_MODEL_PROVIDER=anthropic
#   CREO_MODEL_NAME=claude-sonnet-4-5
#   ANTHROPIC_API_KEY=sk-ant-...

# Provider-native keys are read by the LangChain integration itself when
# CREO_MODEL_API_KEY is not set. Set the one matching your provider:
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- Agent ---
CREO_AGENT_INSTRUCTIONS=You are Creo, a precise and helpful AI agent working inside the Creo workspace.

# --- Server ---
CREO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CREO_LOG_LEVEL=INFO

# --- Knowledge base (ADR-0004; optional) -------------------------------------
# Master switch. The stack also requires Milvus + Unstructured + Embedding
# endpoints below; with any of them missing, KB stays disabled at startup.
CREO_KB_ENABLED=false

# Milvus / Zilliz Cloud (sparse BM25 + dense vectors)
# Zilliz Cloud: CREO_MILVUS_URI=https://in03-xxxx.api-us-west-1.zillizcloud.com
#               CREO_MILVUS_TOKEN=<api-key>
# Self-hosted:  CREO_MILVUS_URI=http://localhost:19530
CREO_MILVUS_URI=
CREO_MILVUS_TOKEN=

# Self-hosted Unstructured partition API
# (docker: quay.io/unstructuredio/unstructured-api, endpoint POST /general/v0/general)
CREO_UNSTRUCTURED_API_URL=http://localhost:8000
# CREO_UNSTRUCTURED_API_KEY=            # only if the service sets UNSTRUCTURED_API_KEY
CREO_UNSTRUCTURED_STRATEGY=hi_res       # auto | fast | hi_res | ocr_only
CREO_UNSTRUCTURED_LANGUAGES=chi_sim,eng # OCR languages (Tesseract codes)

# Embeddings (OpenAI-compatible /embeddings; bge-m3 = 1024 dims)
CREO_KB_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
CREO_KB_EMBEDDING_API_KEY=
CREO_KB_EMBEDDING_MODEL=BAAI/bge-m3
CREO_KB_EMBEDDING_DIM=1024

# Analyzer is fixed when the collection is created ('chinese' = jieba-based,
# for Chinese corpora). Changing model/dim/analyzer requires re-creating
# collections (delete the KB and re-upload/re-ingest).
CREO_KB_ANALYZER=chinese

# CREO_KB_DATA_DIR=data/kb
# CREO_KB_CHUNK_MAX_CHARACTERS=1500
# CREO_KB_UPLOAD_MAX_MB=50
# CREO_KB_SEARCH_TOP_K=5
