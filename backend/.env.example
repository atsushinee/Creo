# Creo backend configuration (copy to .env and fill in real values)
# All variables use the CREO_ prefix unless they are provider-native keys.

# --- LLM ---
# Model string in init_chat_model format: "<provider>:<model>"
# Examples: openai:gpt-4o-mini | anthropic:claude-3-5-sonnet-latest | google_genai:gemini-2.0-flash
CREO_MODEL=openai:gpt-4o-mini
# System prompt for the agent (optional)
CREO_AGENT_INSTRUCTIONS=You are Creo, a precise and helpful AI agent working inside the Creo workspace.

# Provider-native API keys are read by the LangChain provider integration itself.
# Set the one that matches your CREO_MODEL provider:
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- Server ---
CREO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CREO_LOG_LEVEL=INFO
